{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knife Doc Tool",
  "version": "0.0.4",
  "identifier": "com.knifedoc.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knife Doc Tool",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DESsmily/knife-doc-tauri/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEN0M3N0IxRTZCNzJGRDkKUldUWkw3Zm1zWGQ4dlZNUUFVUmM3MmxCaUpjK0ZRR1A4MG9UWU1IMjBvNTFncGJuaTg3a2RwSlgK",
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "shortDescription": "Swagger / OpenAPI 接口文档、在线调试与快捷请求客户端",
    "longDescription": "Knife4j 风格的接口文档客户端：文档拉取与调试请求全部经由 Rust 透明转发，规避浏览器跨域限制，并内置 Apifox 风格的快捷请求。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}