{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knife Doc",
  "version": "1.0.0",
  "identifier": "com.knifedoc.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Knife Doc · 接口文档",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Swagger / OpenAPI 接口文档、在线调试与快捷请求客户端",
    "longDescription": "Knife4j 风格的接口文档客户端：文档拉取与调试请求全部经由 Rust 透明转发，规避浏览器跨域限制，并内置 Apifox 风格的快捷请求。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
